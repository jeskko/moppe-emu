+	while (!play->finish && ((play->buffer_size + play->buffer_writep - play->buffer_readp) % play->buffer_size) / (2 * play->channels) < length && ((play->buffer_size + play->buffer_writep - play->buffer_readp) % play->buffer_size) / (2 * play->channels) < play->left)
